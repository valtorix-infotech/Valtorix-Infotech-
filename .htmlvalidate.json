{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "error",
    "attribute-boolean-style": "off",
    "long-title": "off",
    "no-inline-style": "off",
    "require-sri": "off",
    "script-type": "error",
    "unrecognized-char-reference": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h36": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "wcag/h71": "error",
    "element-permitted-content": "error",
    "element-permitted-occurrences": "error",
    "element-required-attributes": "error",
    "element-required-content": "error",
    "no-dup-attr": "error",
    "no-implicit-button-type": "error",
    "no-abstract-role": "error",
    "no-aria-unsupported-attr": "error",
    "no-autoplay": "error",
    "no-deprecated": "error",
    "no-dup-class": "error",
    "no-dup-id": "error",
    "no-raw-characters": "error",
    "prefer-native-element": "off",
    "valid-autocomplete": "error",
    "valid-id": "error",
    "valid-meta": "error",
    "valid-permissions-policy": "error",
    "valid-src": "error",
    "valid-type": "error"
  }
}
