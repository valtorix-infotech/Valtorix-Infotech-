{
  "name": "valtorix-website",
  "private": true,
  "version": "2.1.0",
  "description": "VALTORIX INFOTECH marketing website — static HTML/CSS/JS with a persistent WebGL stage and a Vercel serverless mail endpoint.",
  "scripts": {
    "dev": "node scripts/serve.js 8099",
    "lint": "node scripts/lint.js",
    "build:brand": "python scripts/build_brand.py",
    "build:stage": "python scripts/build_stage3d.py",
    "build:webp": "python scripts/build_webp.py",
    "use:webp": "python scripts/use_webp.py",
    "build:images": "python scripts/optimize-images.py",
    "build:fonts": "python scripts/build_fonts.py",
    "build:variants": "python scripts/build_images.py",
    "build:schema": "python scripts/build_schema.py",
    "build:faq": "python scripts/build_faq_schema.py",
    "build:meta": "python scripts/build_meta.py",
    "build:copy": "python scripts/build_copy.py",
    "build:srcset": "python scripts/build_srcset.py",
    "check:links": "python scripts/check-links.py",
    "qa": "npm run lint && npm run qa:html && npm run qa:unit && npm run qa:api && npm run qa:security && npm run qa:assets && npm run qa:site && npm run qa:responsive && npm run qa:3d && npm run qa:functions && npm run qa:screenshots && npm run qa:crossbrowser",
    "qa:html": "node scripts/qa-html.js",
    "qa:unit": "python scripts/qa-unit.py",
    "qa:api": "node scripts/qa-api.js",
    "qa:security": "node scripts/qa-security.js",
    "qa:assets": "node scripts/qa-assets.js",
    "qa:site": "node scripts/qa-site.js",
    "qa:responsive": "node scripts/qa-responsive.js",
    "qa:3d": "node scripts/qa-3d.js",
    "qa:functions": "node scripts/qa-functions.js",
    "qa:screenshots": "node scripts/qa-screenshots.js",
    "qa:crossbrowser": "node scripts/qa-crossbrowser.js",
    "qa:lighthouse": "node scripts/qa-lighthouse.js",
    "qa:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@vercel/functions": "^1.0.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "html-validate": "^11.21.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}
